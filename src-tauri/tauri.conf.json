{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astra Tracker",
  "version": "0.1.0",
  "identifier": "com.astra.astra-tracker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Astra Tracker",
        "width": 600,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["astratracker"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyQjFEQjdEMjU4OTlGOTIKUldTU240a2xmZHV4RXAvdVlDMnU2SGw0dVVnblAzTFBSczdMeHJJMys5aWpzR3dIR0syRFhvZ0gK",
      "endpoints": [
        "https://github.com/AstraExpo/AstraTracker/releases/latest/download/latest.json"
      ]
    }
  }
}
